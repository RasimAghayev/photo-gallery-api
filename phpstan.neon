includes:
    - vendor/larastan/larastan/extension.neon
    # Baselines Laravel's own generated User model PHPDoc covariance warning
    # (present in a fresh Laravel 12 install, not an app bug). The other
    # baselined finding this comment used to describe -- the stubbed,
    # unregistered ImagePolicy (TECHNICAL_DEBT.md #4) -- was removed in
    # Phase 7 (dead code); its baseline entries were removed with it.
    # Regenerate with --generate-baseline only when the User model warning
    # is intentionally addressed.
    - phpstan-baseline.neon

parameters:
    paths:
        - app

    # Pragmatic starting level for a Phase 4 pass — not level 9. Raising it
    # further is a separate decision once the current baseline is clean.
    level: 5

    tmpDir: storage/phpstan
