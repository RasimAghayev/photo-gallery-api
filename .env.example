# Copy this file to var/.env and fill in the values for your machine.
# var/.env is ignored by git. Never commit a real credential.
#
# The same values can be supplied through the environment of the process that
# starts the compose stack. The environment wins over the file.
#
# APP_MODE=standalone: the service must be able to run without optional
# external integrations. This project has no optional external integrations;
# only the database configured below is required.

APP_NAME="photo-gallery-api"
APP_MODE=standalone
APP_ENV=local
# The key is generated by "php artisan key:generate --show" and is not part
# of the repository. The application refuses to serve a request without one.
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080

LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# The database of the compose stack.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=abysstask
DB_USERNAME=abyss
# Replace with a strong, random password per environment.
DB_PASSWORD=change_me
# The root password of the database server. It is only used by the first
# start, when the server initialises its own account.
DB_ROOT_PASSWORD=change_me_root

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=log
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# The host port the application is reachable at.
APP_PORT=8080

# Reverse proxy / CORS hardening (set when deployed behind a proxy or SPA).
# TRUSTED_PROXIES=*
# CORS_ALLOWED_ORIGINS=https://example.com
# CORS_MAX_AGE=0
# CORS_SUPPORTS_CREDENTIALS=false
# SESSION_SECURE_COOKIE=true
# RATE_LIMIT_PER_MINUTE=60
